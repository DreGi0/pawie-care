{
  "$schema": "./node_modules/turbo/schema.json",
  "tasks": {
    "generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["generate"]
    },
    "typecheck": {
      "dependsOn": ["generate"]
    },
    "test": {
      "dependsOn": ["generate"],
      // The settings registry test compares the registry with §15 of the rules.
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/reglas-de-negocio.md"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "interactive": true
    }
  }
}
