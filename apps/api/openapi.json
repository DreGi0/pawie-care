{
  "openapi": "3.0.0",
  "paths": {
    "/v1/health": {
      "get": {
        "description": "Revisa la conexión con la base de datos. Lo usan el hosting y el monitoreo.",
        "operationId": "Health_check",
        "parameters": [],
        "responses": {
          "200": {
            "description": "La API y la base de datos responden.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Alguna dependencia no responde. `details.checks` dice cuál.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Estado de la API",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/users/me": {
      "get": {
        "description": "Los datos de la cuenta que inició sesión.",
        "operationId": "Users_me",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "401": {
            "description": "Falta el token o ya venció.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Mi cuenta",
        "tags": [
          "users"
        ]
      }
    },
    "/v1/auth/register": {
      "post": {
        "description": "Crea la cuenta e inicia sesión.",
        "operationId": "Auth_register",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`, con los errores de cada campo en `details`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`EMAIL_TAKEN`: ya hay una cuenta con ese correo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`UNDERAGE`: es menor de 18 años (RN-CTA-02).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos desde la misma IP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Crear una cuenta de dueño",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/login": {
      "post": {
        "operationId": "Auth_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`, con los errores de cada campo en `details`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "`INVALID_CREDENTIALS`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos desde la misma IP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Iniciar sesión",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/refresh": {
      "post": {
        "description": "Cambia el refresh token por un par nuevo. El anterior sigue sirviendo 30 segundos, para reintentar si se pierde la respuesta; después, usarlo otra vez cierra la sesión.",
        "operationId": "Auth_refresh",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "400": {
            "description": "`VALIDATION_FAILED`, con los errores de cada campo en `details`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "`INVALID_REFRESH_TOKEN`: venció, se cerró la sesión o se volvió a usar después de los 30 segundos. Hay que iniciar sesión de nuevo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos desde la misma IP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Renovar los tokens",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "description": "Invalida el refresh token y los demás de la misma sesión. No necesita el token de acceso.",
        "operationId": "Auth_logout",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Sesión cerrada, o el token ya no servía."
          },
          "400": {
            "description": "`VALIDATION_FAILED`, con los errores de cada campo en `details`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "Demasiados intentos desde la misma IP.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "summary": "Cerrar sesión",
        "tags": [
          "auth"
        ]
      }
    },
    "/v1/files": {
      "post": {
        "description": "Devuelve una URL firmada para subir el archivo con PUT, directo al almacenamiento. Después hay que llamar a `complete`.",
        "operationId": "Files_createUpload",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUploadRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileUpload"
                }
              }
            }
          },
          "404": {
            "description": "`FILE_NOT_FOUND`: no existe o es de otra cuenta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "`UNSUPPORTED_FILE_TYPE` o `FILE_TOO_LARGE`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Pedir una subida",
        "tags": [
          "files"
        ]
      }
    },
    "/v1/files/{id}/complete": {
      "post": {
        "description": "Se llama después del PUT.",
        "operationId": "Files_complete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileResponse"
                }
              }
            }
          },
          "404": {
            "description": "`FILE_NOT_FOUND`: no existe o es de otra cuenta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "`FILE_NOT_UPLOADED`: el PUT no llegó.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Confirmar una subida",
        "tags": [
          "files"
        ]
      }
    },
    "/v1/files/{id}": {
      "get": {
        "description": "Sirve para pedir otra URL de descarga cuando la anterior venció.",
        "operationId": "Files_get",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileResponse"
                }
              }
            }
          },
          "404": {
            "description": "`FILE_NOT_FOUND`: no existe o es de otra cuenta.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Ver un archivo",
        "tags": [
          "files"
        ]
      }
    },
    "/v1/catalog": {
      "get": {
        "description": "Distritos, especies, servicios y los límites para armar una reserva.",
        "operationId": "Catalog_get",
        "parameters": [],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Catálogo",
        "tags": [
          "catalog"
        ]
      }
    }
  },
  "info": {
    "title": "Pawie Care API",
    "description": "API REST de Pawie Care. Las reglas de negocio están en docs/reglas-de-negocio.md y el diseño en docs/arquitectura.md. Los errores siempre tienen la forma de `ErrorResponse`.",
    "version": "1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthChecks": {
        "type": "object",
        "properties": {
          "database": {
            "enum": [
              "up"
            ],
            "type": "string",
            "description": "Conexión con PostgreSQL."
          }
        },
        "required": [
          "database"
        ]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string",
            "description": "La API y sus dependencias responden."
          },
          "checks": {
            "description": "Resultado de cada dependencia.",
            "allOf": [
              {
                "$ref": "#/components/schemas/HealthChecks"
              }
            ]
          }
        },
        "required": [
          "status",
          "checks"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "description": "Código de estado HTTP.",
            "example": 404
          },
          "errorCode": {
            "type": "string",
            "description": "Código estable del error, en inglés. El cliente decide qué hacer según este valor, no según el mensaje.",
            "example": "NOT_FOUND"
          },
          "message": {
            "type": "string",
            "description": "Mensaje en español para mostrarle al usuario.",
            "example": "No encontramos lo que buscas."
          },
          "details": {
            "type": "object",
            "additionalProperties": true,
            "description": "Información adicional. En los errores de validación trae los mensajes de cada campo.",
            "example": {
              "email": [
                "email must be an email"
              ]
            }
          }
        },
        "required": [
          "statusCode",
          "errorCode",
          "message"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "OWNER",
          "CAREGIVER",
          "ADMIN"
        ],
        "description": "RN-CTA-01: una cuenta puede ser dueño y cuidador a la vez."
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "example": "daniela@example.com"
          },
          "firstName": {
            "type": "string",
            "example": "Daniela"
          },
          "lastName": {
            "type": "string",
            "example": "Pérez"
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "example": "1992-05-20"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "example": "+503 7000 0000"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Role"
            },
            "description": "RN-CTA-01: una cuenta puede ser dueño y cuidador a la vez."
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "birthDate",
          "phone",
          "roles"
        ]
      },
      "RegisterRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "example": "daniela@example.com",
            "description": "Se guarda en minúsculas."
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128
          },
          "firstName": {
            "type": "string",
            "maxLength": 80,
            "example": "Daniela"
          },
          "lastName": {
            "type": "string",
            "maxLength": 80,
            "example": "Pérez"
          },
          "birthDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "format": "date",
            "example": "1992-05-20",
            "description": "AAAA-MM-DD. Solo pueden registrarse mayores de 18 años (RN-CTA-02)."
          },
          "phone": {
            "type": "string",
            "example": "+503 7000 0000"
          }
        },
        "required": [
          "email",
          "password",
          "firstName",
          "lastName",
          "birthDate"
        ]
      },
      "AuthSession": {
        "type": "object",
        "properties": {
          "tokenType": {
            "enum": [
              "Bearer"
            ],
            "type": "string"
          },
          "accessToken": {
            "type": "string",
            "description": "JWT de vida corta para el header Authorization."
          },
          "expiresIn": {
            "type": "integer",
            "example": 900,
            "description": "Segundos que dura el accessToken."
          },
          "refreshToken": {
            "type": "string",
            "description": "POST /v1/auth/refresh lo cambia por uno nuevo, y este deja de servir 30 segundos después. Hay que guardarlo en el almacenamiento seguro del teléfono."
          },
          "refreshTokenExpiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "$ref": "#/components/schemas/UserProfile"
          }
        },
        "required": [
          "tokenType",
          "accessToken",
          "expiresIn",
          "refreshToken",
          "refreshTokenExpiresAt",
          "user"
        ]
      },
      "LoginRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "daniela@example.com"
          },
          "password": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshTokenRequest": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "maxLength": 256,
            "description": "El refresh token que devolvió el inicio de sesión o el último refresh."
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "UploadPurpose": {
        "type": "string",
        "enum": [
          "PET_PHOTO",
          "VET_INSTRUCTION",
          "VACCINATION_RECORD"
        ]
      },
      "CreateUploadRequest": {
        "type": "object",
        "properties": {
          "purpose": {
            "allOf": [
              {
                "$ref": "#/components/schemas/UploadPurpose"
              }
            ]
          },
          "contentType": {
            "type": "string",
            "maxLength": 100,
            "example": "image/jpeg",
            "description": "Fotos: JPEG, PNG, WebP o HEIC, hasta 10 MB. Recetas y carnés de vacunas: también PDF, hasta 15 MB."
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 1,
            "example": 245000,
            "description": "Tamaño exacto del archivo en bytes. La subida tiene que coincidir."
          }
        },
        "required": [
          "purpose",
          "contentType",
          "sizeBytes"
        ]
      },
      "FilePurpose": {
        "type": "string",
        "enum": [
          "PET_PHOTO",
          "CAREGIVER_PHOTO",
          "VET_INSTRUCTION",
          "VACCINATION_RECORD"
        ]
      },
      "FileResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "purpose": {
            "allOf": [
              {
                "$ref": "#/components/schemas/FilePurpose"
              }
            ]
          },
          "contentType": {
            "type": "string",
            "example": "image/jpeg"
          },
          "sizeBytes": {
            "type": "integer",
            "nullable": true,
            "description": "Null hasta que se sube."
          },
          "uploadedAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "url": {
            "type": "string",
            "nullable": true,
            "description": "URL firmada para descargarlo, que vence en 10 minutos. Null hasta que se sube."
          }
        },
        "required": [
          "id",
          "purpose",
          "contentType",
          "sizeBytes",
          "uploadedAt",
          "url"
        ]
      },
      "FileUpload": {
        "type": "object",
        "properties": {
          "file": {
            "$ref": "#/components/schemas/FileResponse"
          },
          "uploadUrl": {
            "type": "string",
            "description": "Hay que subir el archivo con PUT a esta URL, que vence en 10 minutos."
          },
          "uploadMethod": {
            "enum": [
              "PUT"
            ],
            "type": "string"
          },
          "uploadHeaders": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "Content-Type": "image/jpeg"
            },
            "description": "Headers que tiene que llevar el PUT, tal cual."
          },
          "uploadExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "file",
          "uploadUrl",
          "uploadMethod",
          "uploadHeaders",
          "uploadExpiresAt"
        ]
      },
      "DistrictOption": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "santa-tecla"
          },
          "name": {
            "type": "string",
            "example": "Santa Tecla"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ]
      },
      "SpeciesOption": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "example": "DOG"
          },
          "name": {
            "type": "string",
            "example": "Perro"
          }
        },
        "required": [
          "id",
          "code",
          "name"
        ]
      },
      "ServiceCode": {
        "type": "string",
        "enum": [
          "HOME_VISIT",
          "OVERNIGHT_STAY"
        ]
      },
      "ServiceOption": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "allOf": [
              {
                "$ref": "#/components/schemas/ServiceCode"
              }
            ]
          },
          "name": {
            "type": "string",
            "example": "Visita a domicilio"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "description"
        ]
      },
      "BookingRules": {
        "type": "object",
        "properties": {
          "maxPetsPerBooking": {
            "type": "integer",
            "example": 3,
            "description": "RN-RES-03"
          },
          "minLeadTimeMinutes": {
            "type": "integer",
            "example": 120,
            "description": "RN-RES-05: el primer tramo empieza al menos esto después de pedirlo."
          },
          "homeVisitMinutes": {
            "type": "integer",
            "example": 60,
            "description": "RN-SER-01: cada visita ocupa este tiempo en el calendario del cuidador."
          },
          "overnightStartMinute": {
            "type": "integer",
            "example": 1140,
