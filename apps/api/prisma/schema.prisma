// Data model of the Pawie Care API. The business rules it implements are in
// docs/reglas-de-negocio.md; cite their IDs (RN-XXX-00) next to the models.
//
// Conventions (docs/arquitectura.md §4 and §8):
// - Models in PascalCase; tables, columns and enum types in snake_case.
// - IDs are UUIDv7, generated by PostgreSQL 18 with uuidv7().
// - Money in integer cents (…Cents) and percentages in basis points (…Bp, 1500 = 15%).
// - Instants are timestamptz, calendar dates are date, and times of day are minutes
//   since midnight in America/El_Salvador.
// - What Prisma can't express lives in the hand-written migration
//   prisma/migrations/20261017233100_constraints: btree_gist, the exclusion constraint
//   on booking slots, CHECK constraints and partial unique indexes. When a model
//   below says "CHECK" or "partial unique index", that migration has it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Accounts (RN-CTA) ──────────────────────────────────────────────────────────

/// RN-CTA-01
enum Role {
  OWNER
  CAREGIVER
  ADMIN

  @@map("role")
}

model User {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stored trimmed and lowercased (CHECK), so the unique index is case-insensitive.
  email        String   @unique
  /// argon2id hash. Null for accounts that can't sign in, like the seeded caregivers.
  passwordHash String?  @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  phone        String?
  /// RN-CTA-02: only adults can sign up. Checked when the account is created.
  birthDate    DateTime @map("birth_date") @db.Date
  /// RN-CTA-01: one account can be owner and caregiver at the same time. At least
  /// one role (CHECK).
  roles        Role[]
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens        RefreshToken[]
  addresses            Address[]
  caregiverProfile     CaregiverProfile?
  pets                 Pet[]
  files                File[]
  bookings             Booking[]
  bookingStatusChanges BookingStatusChange[]

  @@map("users")
}

/// Refresh tokens rotate on every use (docs/arquitectura.md §3.1). Every token
/// issued from one sign-in shares a family, so using a rotated token again, which
/// means it leaked, revokes the whole family.
model RefreshToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  /// SHA-256 of the token. The token itself is never stored.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  /// When it was exchanged for the next token of its family.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Where the owner wants the service. Bookings keep a copy, and the caregiver only
/// sees it once the booking is confirmed (RN-CTA-04).
model Address {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// What the owner calls it, such as "Casa".
  label      String
  /// Street, number and neighborhood (colonia or residencial).
  street     String
  /// Apartment, gate code or landmarks.
  details    String?
  districtId String   @map("district_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  district District  @relation(fields: [districtId], references: [id])
  bookings Booking[]

  @@index([userId])
  @@map("addresses")
}

// ─── Catalog ────────────────────────────────────────────────────────────────────

/// RN-CUI-04: the former municipalities of the AMSS.
model District {
  id   String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stable identifier for the seed and the clients, such as "santa-tecla".
  slug String @unique
  name String @unique

  addresses          Address[]
  caregiverDistricts CaregiverDistrict[]
  bookings           Booking[]

  @@map("districts")
}

/// RN-MAS-01: a catalog, so another species can be added without changing the model.
model Species {
  id   String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stable identifier, such as "DOG".
  code String @unique
  name String

  pets Pet[]

  @@map("species")
}

enum ServiceCode {
  /// RN-SER-01
  HOME_VISIT
  /// RN-SER-02
  OVERNIGHT_STAY

  @@map("service_code")
}

/// RN-SER. Durations and hours are settings (§15), not columns.
model Service {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  code        ServiceCode @unique
  name        String
  description String

  caregiverPrices CaregiverServicePrice[]
  bookings        Booking[]
  bookingSlots    BookingSlot[]

  @@map("services")
}

// ─── Caregivers (RN-CUI) ────────────────────────────────────────────────────────

/// RN-CUI-03
enum CaregiverStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED

  @@map("caregiver_status")
}

/// RN-MAS-04: computed by the system, never chosen by the owner.
enum CareLevel {
  STANDARD
  SPECIAL

  @@map("care_level")
}

/// RN-NIV-01: computed by the system from the reviews, the completed services and the
/// certifications (RN-NIV-02), never chosen by the caregiver. The order is the order
/// of the levels, so SQL can compare them.
enum CaregiverLevel {
  NEW
  TRUSTED
  PRO
  SUPER

  @@map("caregiver_level")
}

/// RN-CUI-18: skills the caregiver declares, from a catalog. Nobody verifies them
/// (RN-CUI-19), so they are labels, not badges, and searches don't filter by them.
enum CaregiverSkill {
  LARGE_DOGS
  CATS
  PUPPIES
  SENIOR_PETS
  DIFFICULT_BEHAVIOR

  @@map("caregiver_skill")
}

/// The caregiver side of an account. The ⭐ is a CaregiverCertification (RN-CUI-11).
model CaregiverProfile {
  userId                String          @id @map("user_id") @db.Uuid
  status                CaregiverStatus @default(PENDING_APPROVAL)
  /// RN-RES-01: only approved and active caregivers show up in searches.
  isActive              Boolean         @default(false) @map("is_active")
  /// RN-CUI-16: requests are confirmed without waiting for the caregiver.
  instantBooking        Boolean         @default(false) @map("instant_booking")
  /// RN-CUI-05: last day covered by the student ID or enrollment proof. The badge
  /// shows while it hasn't passed.
  vetStudentUntil       DateTime?       @map("vet_student_until") @db.Date
  bio                   String?
  photoFileId           String?         @map("photo_file_id") @db.Uuid
  /// Ratings from 1 to 5. The average is ratingSum / ratingCount, kept as two
  /// integers so it never drifts (CHECK: count ≤ sum ≤ 5 × count). RN-RSE-05: only
  /// bookings made in Pawie count.
  ratingCount           Int             @default(0) @map("rating_count")
  ratingSum             Int             @default(0) @map("rating_sum")
  /// RN-CUI-10: the ⭐ also depends on the average of special-care bookings alone.
  specialRatingCount    Int             @default(0) @map("special_rating_count")
  specialRatingSum      Int             @default(0) @map("special_rating_sum")
  /// RN-RES-02: number of services completed in Pawie.
  completedBookingCount Int             @default(0) @map("completed_booking_count")
  /// RN-NIV-04: stored so searches can filter and sort by it in SQL. Recalculate it in
  /// the same transaction that changes the ratings, the completed services or the
  /// certifications (src/caregivers/recalculate-level.ts).
  level                 CaregiverLevel  @default(NEW)
  skills                CaregiverSkill[] @default([])
  /// RN-CAN-05: hidden from searches until then.
  suspendedUntil        DateTime?       @map("suspended_until") @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoFile      File?                    @relation(fields: [photoFileId], references: [id], onDelete: SetNull)
  districts      CaregiverDistrict[]
  servicePrices  CaregiverServicePrice[]
  availability   CaregiverAvailability[]
  certifications CaregiverCertification[]
  bookings       Booking[]

  @@map("caregiver_profiles")
}

/// RN-CUI-04: districts the caregiver covers.
model CaregiverDistrict {
  caregiverId String @map("caregiver_id") @db.Uuid
  districtId  String @map("district_id") @db.Uuid

  caregiver CaregiverProfile @relation(fields: [caregiverId], references: [userId], onDelete: Cascade)
  district  District         @relation(fields: [districtId], references: [id])

  @@id([caregiverId, districtId])
  @@index([districtId])
  @@map("caregiver_districts")
}

/// RN-CUI-17, RN-PRE-01. A row means the caregiver offers that service. The price
/// range depends on the caregiver's level, not on the pets' (RN-PRE-01).
model CaregiverServicePrice {
  caregiverId String    @map("caregiver_id") @db.Uuid
  serviceId   String    @map("service_id") @db.Uuid
  /// Price for one pet, before fees. Null means the suggested price in force for the
  /// caregiver's level (setting pricing.priceRanges, RN-PRE-01). The range can change after the caregiver sets a
  /// price, so it isn't a CHECK: pricing clamps the price to the current range.
  priceCents  Int?      @map("price_cents")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  caregiver CaregiverProfile @relation(fields: [caregiverId], references: [userId], onDelete: Cascade)
  service   Service          @relation(fields: [serviceId], references: [id])

  @@id([caregiverId, serviceId])
  @@index([serviceId])
  @@map("caregiver_service_prices")
}

/// Weekly schedule. A caregiver is available when one of these windows covers a slot
/// and no blocking slot of theirs overlaps it.
///
/// A window starts on `weekday` at `startMinute` and ends `endMinute` minutes after
/// that same midnight, so a window that crosses midnight is a single row with
/// endMinute past 1440: an overnight from 19:00 to 08:00 is startMinute 1140 and
/// endMinute 1920. CHECK: weekday 1–7, startMinute 0–1439, and the window lasts at
/// most 24 h.
model CaregiverAvailability {
  id          String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  caregiverId String @map("caregiver_id") @db.Uuid
  /// ISO day of the week: 1 is Monday and 7 is Sunday.
  weekday     Int    @db.SmallInt
  /// Minutes since midnight, America/El_Salvador.
  startMinute Int    @map("start_minute") @db.SmallInt
  /// Minutes since the same midnight as startMinute.
  endMinute   Int    @map("end_minute") @db.SmallInt

  caregiver CaregiverProfile @relation(fields: [caregiverId], references: [userId], onDelete: Cascade)

  @@unique([caregiverId, weekday, startMinute])
  @@map("caregiver_availability")
}

/// RN-CUI-11. The demo has a single type, SPECIAL_CARE: the ⭐.
model CertificationType {
  id   String @id @default(dbgenerated("uuidv7()")) @db.Uuid
  /// Stable identifier, such as "SPECIAL_CARE".
  code String @unique
  name String

  certifications CaregiverCertification[]

  @@map("certification_types")
}

enum CertificationStatus {
  ACTIVE
  /// Past its validity, or replaced by a renewal (RN-CUI-09).
  EXPIRED
  /// Taken away for good (RN-CUI-10).
  REVOKED

  @@map("certification_status")
}

/// RN-CUI-07 to RN-CUI-11. Partial unique index: at most one ACTIVE certification per
/// caregiver and type.
model CaregiverCertification {
  id                  String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  caregiverId         String              @map("caregiver_id") @db.Uuid
  certificationTypeId String              @map("certification_type_id") @db.Uuid
  status              CertificationStatus @default(ACTIVE)
  obtainedOn          DateTime            @map("obtained_on") @db.Date
  /// Last valid day (RN-CUI-09). A booking needs it valid through its end.
  /// CHECK: not before obtainedOn.
  validUntil          DateTime            @map("valid_until") @db.Date
  /// RN-CUI-10, RN-CAN-05: a temporary suspension. It stays ACTIVE, but doesn't count
  /// until then.
  suspendedUntil      DateTime?           @map("suspended_until") @db.Timestamptz(3)
  /// CHECK: set exactly when the status is REVOKED.
  revokedAt           DateTime?           @map("revoked_at") @db.Timestamptz(3)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  caregiver         CaregiverProfile  @relation(fields: [caregiverId], references: [userId], onDelete: Cascade)
  certificationType CertificationType @relation(fields: [certificationTypeId], references: [id])

  @@index([caregiverId, certificationTypeId])
  @@map("caregiver_certifications")
}

// ─── Pets (RN-MAS) ──────────────────────────────────────────────────────────────

enum PetSex {
  MALE
  FEMALE

  @@map("pet_sex")
}

/// RN-MAS-02, RN-MAS-03. The care level isn't stored here: it's computed for each
/// booking from the care needs active on its dates (RN-MAS-04, RN-MAS-05).
model Pet {
  id                     String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId                String    @map("owner_id") @db.Uuid
  speciesId              String    @map("species_id") @db.Uuid
  name                   String
  breed                  String?
  birthDate              DateTime  @map("birth_date") @db.Date
  /// RN-MAS-02: the birth date can be approximate.
  birthDateIsApproximate Boolean   @default(false) @map("birth_date_is_approximate")
  sex                    PetSex
  /// CHECK: positive.
  weightGrams            Int?      @map("weight_grams")
  isSterilized           Boolean?  @map("is_sterilized")
  temperament            String?
  handlingNotes          String?   @map("handling_notes")
  /// The pet's regular vet.
  vetName                String?   @map("vet_name")
  vetClinic              String?   @map("vet_clinic")
  vetPhone               String?   @map("vet_phone")
  /// Free text for the profile. What the caregiver has to do goes in PetCareNeed.
  healthConditions       String?   @map("health_conditions")
  medications            String?
  photoFileId            String?   @map("photo_file_id") @db.Uuid
  /// Archived pets keep their bookings but can't be booked again.
  archivedAt             DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  species         Species          @relation(fields: [speciesId], references: [id])
  photoFile       File?            @relation("PetPhoto", fields: [photoFileId], references: [id], onDelete: SetNull)
  vaccinations    PetVaccination[]
  vetInstructions VetInstruction[]
  careNeeds       PetCareNeed[]
  bookings        BookingPet[]

  @@index([ownerId])
  @@map("pets")
}

/// RN-MAS-02
model PetVaccination {
  id             String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  petId          String    @map("pet_id") @db.Uuid
  /// Such as "Antirrábica".
  name           String
  administeredOn DateTime  @map("administered_on") @db.Date
  /// CHECK: after administeredOn.
  nextDueOn      DateTime? @map("next_due_on") @db.Date
  /// Photo of the vaccination record.
  fileId         String?   @map("file_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  pet  Pet   @relation(fields: [petId], references: [id], onDelete: Cascade)
  file File? @relation("VaccinationRecord", fields: [fileId], references: [id], onDelete: SetNull)

  @@index([petId])
  @@map("pet_vaccinations")
}

/// RN-MAS-08: written vet instructions (a prescription or post-operative
/// instructions) uploaded by the owner. Clinical care needs point to one, and Special
/// bookings attach them (RN-RES-03).
model VetInstruction {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  petId     String   @map("pet_id") @db.Uuid
  fileId    String   @map("file_id") @db.Uuid
  /// Date written on the document.
  issuedOn  DateTime @map("issued_on") @db.Date
  vetName   String?  @map("vet_name")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  pet       Pet                     @relation(fields: [petId], references: [id], onDelete: Cascade)
  file      File                    @relation("VetInstructionDocument", fields: [fileId], references: [id])
  careNeeds PetCareNeed[]
  bookings  BookingVetInstruction[]

  // Target of the composite foreign keys that keep care needs and bookings from
  // pointing to another pet's instructions.
  @@unique([id, petId])
  @@index([petId])
  @@map("vet_instructions")
}

/// What the caregiver would have to do during a service (RN-MAS-06, RN-CUI-12,
/// RN-CUI-13). src/pets/care-tasks.ts has the group of each task.
enum CareTask {
  // Clinical: they make the pet Special and need written vet instructions (RN-MAS-08).
  MEDICATION
  WOUND_CARE
  POST_OPERATIVE_RECOVERY
  SYRINGE_FEEDING
  PRESCRIBED_REST
  CHRONIC_CONDITION_MONITORING
  // Assistance: they make the pet Special; the owner's written instructions are enough.
  MOBILITY_ASSISTANCE
  INCONTINENCE_HYGIENE
  // Prohibited for every caregiver (RN-CUI-13): the pet can't be booked while one is
  // active (RN-MAS-09).
  INJECTION
  IV_FLUIDS
  STITCH_OR_DRAIN_REMOVAL
  TUBE_PLACEMENT
  SEDATION
  DOSE_CHANGE
  DIAGNOSIS_OR_PRESCRIPTION

  @@map("care_task")
}

/// A care task the pet needs between two dates. A booking counts it when their dates
/// overlap (RN-MAS-05). CHECK, by group (RN-MAS-08):
/// - clinical tasks need vetInstructionId;
/// - assistance tasks need ownerInstructions;
/// - endsOn can only be empty for CHRONIC_CONDITION_MONITORING, MOBILITY_ASSISTANCE
///   and the prohibited tasks, and is never before startsOn.
model PetCareNeed {
  id                String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  petId             String    @map("pet_id") @db.Uuid
  task              CareTask
  /// First day, America/El_Salvador.
  startsOn          DateTime  @map("starts_on") @db.Date
  /// Last day, inclusive. Null means it has no end yet.
  endsOn            DateTime? @map("ends_on") @db.Date
  vetInstructionId  String?   @map("vet_instruction_id") @db.Uuid
  ownerInstructions String?   @map("owner_instructions")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  pet            Pet             @relation(fields: [petId], references: [id], onDelete: Cascade)
  /// Composite key: the instructions must belong to the same pet.
  vetInstruction VetInstruction? @relation(fields: [vetInstructionId, petId], references: [id, petId], onDelete: Restrict)

  @@index([petId])
  @@map("pet_care_needs")
}

// ─── Files ──────────────────────────────────────────────────────────────────────

enum FilePurpose {
  PET_PHOTO
  CAREGIVER_PHOTO
  VET_INSTRUCTION
  VACCINATION_RECORD

  @@map("file_purpose")
}

/// Metadata of a file in the private bucket (docs/arquitectura.md §4.11). Uploads
/// arrive with the files module.
model File {
  id           String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  uploadedById String      @map("uploaded_by_id") @db.Uuid
  purpose      FilePurpose
  /// Object key in the bucket.
  storageKey   String      @unique @map("storage_key")
  contentType  String      @map("content_type")
  /// Known once the upload finishes.
  sizeBytes    Int?        @map("size_bytes")
  /// Null while the client is still uploading it.
  uploadedAt   DateTime?   @map("uploaded_at") @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  uploadedBy        User               @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  caregiverProfiles CaregiverProfile[]
  pets              Pet[]              @relation("PetPhoto")
  vaccinations      PetVaccination[]   @relation("VaccinationRecord")
  vetInstructions   VetInstruction[]   @relation("VetInstructionDocument")

  @@index([uploadedById])
  @@map("files")
}

// ─── Bookings (RN-RES) ──────────────────────────────────────────────────────────

/// docs/reglas-de-negocio.md §8.2, including the statuses after the demo.
enum BookingStatus {
  REQUESTED
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CLOSED
  REJECTED
  EXPIRED
  CANCELLED_BY_OWNER
  CANCELLED_BY_CAREGIVER
  DISPUTED

  @@map("booking_status")
}

/// One caregiver, one service, its pets and one or more slots, paid once.
///
/// CHECK: blocksCalendar is true exactly when the status holds the caregiver's time
/// (every status except REJECTED, EXPIRED and the two cancellations). It's part of the
/// foreign key of booking_slots, so changing it cascades to the slots, where the
/// exclusion constraint reads it.
model Booking {
  id                          String        @id @default(dbgenerated("uuidv7()")) @db.Uuid
  ownerId                     String        @map("owner_id") @db.Uuid
  caregiverId                 String        @map("caregiver_id") @db.Uuid
  /// The booked service. An overnight booking can also have home visit slots for the
  /// daytime (RN-SER-03), priced as visits at the booking's level.
  serviceId                   String        @map("service_id") @db.Uuid
  /// RN-MAS-05, RN-MAS-06: SPECIAL if any pet is Special on the booking's dates. It
  /// requires the ⭐ but doesn't change the price.
  careLevel                   CareLevel     @map("care_level")
  /// RN-NIV-06, RN-PRE-07: the caregiver's level when the booking was created.
  caregiverLevel              CaregiverLevel @map("caregiver_level")
  /// RN-PRE-09: the booking took the owner's first service without a service fee.
  firstServiceFeeWaived       Boolean       @default(false) @map("first_service_fee_waived")
  status                      BookingStatus
  blocksCalendar              Boolean       @map("blocks_calendar")
  /// Start of the first slot and end of the last one. CHECK: startsAt < endsAt.
  startsAt                    DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt                      DateTime      @map("ends_at") @db.Timestamptz(3)
  /// RN-CTA-04: a copy of the address, so editing or deleting it later doesn't
  /// change the booking. addressId only says where it came from.
  addressId                   String?       @map("address_id") @db.Uuid
  districtId                  String        @map("district_id") @db.Uuid
  addressStreet               String        @map("address_street")
  addressDetails              String?       @map("address_details")
  /// RN-RES-03
  instructions                String?
  /// RN-RES-04
  emergencyContactName        String        @map("emergency_contact_name")
  emergencyContactPhone       String        @map("emergency_contact_phone")
  emergencyVetName            String?       @map("emergency_vet_name")
  emergencyVetPhone           String?       @map("emergency_vet_phone")
  /// Declared by the owner; nothing is charged up front (RN-EME-04).
  emergencyPreauthorizedCents Int           @map("emergency_preauthorized_cents")
  emergencyClinicConsent      Boolean       @map("emergency_clinic_consent")
  /// RN-RES-06. CHECK: set while REQUESTED.
  responseDueAt               DateTime?     @map("response_due_at") @db.Timestamptz(3)
  /// RN-RES-07. CHECK: set while PENDING_PAYMENT.
  paymentDueAt                DateTime?     @map("payment_due_at") @db.Timestamptz(3)

  // Copy of the prices and settings used (RN-PRE-07). Each amount is rounded once.
  // CHECK: totalCents = subtotalCents + ownerServiceFeeCents, and
  // caregiverPayoutCents = subtotalCents − caregiverCommissionCents.
  /// What the caregiver charges: the sum of the slots, additional pets included.
  subtotalCents            Int  @map("subtotal_cents")
  /// RN-PRE-03
  ownerServiceFeeBp        Int  @map("owner_service_fee_bp")
  ownerServiceFeeCents     Int  @map("owner_service_fee_cents")
  /// What the owner pays.
  totalCents               Int  @map("total_cents")
  /// RN-PRE-04
  caregiverCommissionBp    Int  @map("caregiver_commission_bp")
  caregiverCommissionCents Int  @map("caregiver_commission_cents")
  caregiverPayoutCents     Int  @map("caregiver_payout_cents")
  /// RN-PRE-02
  additionalPetSurchargeBp Int  @map("additional_pet_surcharge_bp")
  /// RN-PRE-06
  guaranteeFundBp          Int  @map("guarantee_fund_bp")
  vatBp                    Int  @map("vat_bp")
  /// RN-PAG-01
  gatewayFeeBp             Int  @map("gateway_fee_bp")
  /// Everything the calculation used, such as the price ranges and the caregiver's
  /// prices before clamping, so it can be explained later.
  pricingSnapshot          Json @map("pricing_snapshot")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  owner         User                  @relation(fields: [ownerId], references: [id])
  caregiver     CaregiverProfile      @relation(fields: [caregiverId], references: [userId])
  service       Service               @relation(fields: [serviceId], references: [id])
  address       Address?              @relation(fields: [addressId], references: [id], onDelete: SetNull)
  district      District              @relation(fields: [districtId], references: [id])
  pets          BookingPet[]
  slots         BookingSlot[]
  statusChanges BookingStatusChange[]
  payments      Payment[]

  // Target of the foreign key of booking_slots.
  @@unique([id, caregiverId, blocksCalendar])
  @@index([caregiverId, startsAt])
  @@index([ownerId, startsAt])
  @@map("bookings")
}

/// RN-RES-03: the pets of a booking.
model BookingPet {
  bookingId String    @map("booking_id") @db.Uuid
  petId     String    @map("pet_id") @db.Uuid
  /// The pet's level on the booking's dates (RN-MAS-05).
  careLevel CareLevel @map("care_level")

  booking         Booking                 @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  pet             Pet                     @relation(fields: [petId], references: [id])
  vetInstructions BookingVetInstruction[]

  @@id([bookingId, petId])
  @@index([petId])
  @@map("booking_pets")
}

/// RN-RES-03: vet instructions attached to a Special booking. The composite keys make
/// sure they belong to one of the booking's pets.
model BookingVetInstruction {
  bookingId        String @map("booking_id") @db.Uuid
  vetInstructionId String @map("vet_instruction_id") @db.Uuid
  petId            String @map("pet_id") @db.Uuid

  bookingPet     BookingPet     @relation(fields: [bookingId, petId], references: [bookingId, petId], onDelete: Cascade)
  vetInstruction VetInstruction @relation(fields: [vetInstructionId, petId], references: [id, petId])

  @@id([bookingId, vetInstructionId])
  @@index([vetInstructionId, petId])
  @@map("booking_vet_instructions")
}

/// A visit or a night of a booking, over [startsAt, endsAt). Each slot blocks only
/// its own time (RN-CUI-15): the exclusion constraint booking_slots_no_overlap
/// rejects two blocking slots of the same caregiver that overlap.
model BookingSlot {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookingId      String   @map("booking_id") @db.Uuid
  /// Both copied from the booking through one composite foreign key, so they can't
  /// drift from it; the exclusion constraint needs them on this table.
  caregiverId    String   @map("caregiver_id") @db.Uuid
  blocksCalendar Boolean  @map("blocks_calendar")
  serviceId      String   @map("service_id") @db.Uuid
  /// CHECK: startsAt < endsAt.
  startsAt       DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime @map("ends_at") @db.Timestamptz(3)
  /// The caregiver's price for this service at the booking's level, for one pet.
  unitPriceCents Int      @map("unit_price_cents")
  /// unitPriceCents plus the additional pets (RN-PRE-02), rounded once.
  subtotalCents  Int      @map("subtotal_cents")

  booking Booking @relation(fields: [bookingId, caregiverId, blocksCalendar], references: [id, caregiverId, blocksCalendar], onDelete: Cascade, onUpdate: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
  @@map("booking_slots")
}

/// Every status change of a booking (docs/arquitectura.md §4.7).
model BookingStatusChange {
  id          String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookingId   String         @map("booking_id") @db.Uuid
  /// Null for the status the booking was created with.
  fromStatus  BookingStatus? @map("from_status")
  toStatus    BookingStatus  @map("to_status")
  /// Null when the system made the change, such as an expiry or a webhook.
  changedById String?        @map("changed_by_id") @db.Uuid
  reason      String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy User?   @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@map("booking_status_changes")
}

// ─── Payments (RN-PAG) ──────────────────────────────────────────────────────────

enum PaymentProvider {
  WOMPI

  @@map("payment_provider")
}

enum PaymentStatus {
  /// The payment link exists and hasn't been paid.
  PENDING
  /// Approved by the gateway (webhook, RN-PAG-02) and applied to the booking.
  APPROVED
  /// Not set yet: Wompi only sends webhooks for successful payments, and after a
  /// declined card the owner retries on the same link (RN-PAG-08).
  DECLINED
  /// The link expired without a payment. Not set yet: the link expires with the
  /// booking's payment deadline, and the booking's status already shows it.
  EXPIRED
  /// Approved by the gateway, but it couldn't confirm the booking: it arrived after
  /// the deadline and the slot was taken (RN-PAG-06), or the booking was already paid
  /// or cancelled by the owner, or the amount differs (RN-PAG-07). It's refunded from
  /// the Wompi panel (RN-PAG-05).
  REFUND_PENDING
  /// An admin recorded the refund.
  REFUNDED

  @@map("payment_status")
}

/// One payment attempt. Its id is the identificadorEnlaceComercio sent to Wompi.
/// Partial unique index: at most one APPROVED payment per booking.
model Payment {
  id                    String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  bookingId             String          @map("booking_id") @db.Uuid
  provider              PaymentProvider
  status                PaymentStatus   @default(PENDING)
  /// CHECK: positive.
  amountCents           Int             @map("amount_cents")
  /// Wompi's idEnlace and the URL of its payment page.
  providerLinkId        String?         @unique @map("provider_link_id")
  checkoutUrl           String?         @map("checkout_url")
  /// Wompi's IdTransaccion, known once the owner pays.
  providerTransactionId String?         @unique @map("provider_transaction_id")
  /// Wompi's esReal: false for test transactions (RN-PAG-01).
  isLive                Boolean?        @map("is_live")
  /// When the gateway approved it. CHECK: set exactly for APPROVED, REFUND_PENDING
  /// and REFUNDED.
  approvedAt            DateTime?       @map("approved_at") @db.Timestamptz(3)
  refundedAt            DateTime?       @map("refunded_at") @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking       Booking        @relation(fields: [bookingId], references: [id])
  webhookEvents WebhookEvent[]

  @@index([bookingId])
  @@map("payments")
}

/// Webhooks as they arrive (docs/arquitectura.md §6). The unique key makes a repeated
/// webhook a no-op.
model WebhookEvent {
  id          String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  provider    PaymentProvider
  /// The provider's ID for what the event is about: Wompi's IdTransaccion.
  externalId  String          @map("external_id")
  payload     Json
  paymentId   String?         @map("payment_id") @db.Uuid
  receivedAt  DateTime        @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?       @map("processed_at") @db.Timestamptz(3)
  /// Why processing failed, to retry it or review it.
  error       String?

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([provider, externalId])
  @@map("webhook_events")
}

// ─── Settings (§15) ─────────────────────────────────────────────────────────────

/// A configurable parameter (docs/reglas-de-negocio.md §15). The keys, their
/// validators and the rules they implement are in src/settings/settings.registry.ts;
/// read values through SettingsService, which validates them.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  changes SettingChange[]

  @@map("settings")
}

/// Who changed a parameter, when, and the value it had (docs/arquitectura.md §4.9).
model SettingChange {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  settingKey    String   @map("setting_key")
  /// Null when the change created the parameter.
  previousValue Json?    @map("previous_value")
  newValue      Json     @map("new_value")
  /// "seed", or the name given to the settings:set script. After the demo, the admin.
  changedBy     String   @map("changed_by")
  reason        String?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  setting Setting @relation(fields: [settingKey], references: [key])

  @@index([settingKey, createdAt])
  @@map("setting_changes")
}
