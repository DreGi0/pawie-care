# Copy to .env and adjust. Validated at startup by src/config/environment.ts.
# Values match docker-compose.yml at the repo root.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pawie:pawie@localhost:5432/pawie
# Comma-separated browser origins allowed by CORS (the native app doesn't need any)
CORS_ORIGINS=
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Number of reverse proxies in front of the API (1 on Railway or Render)
TRUST_PROXY=0

# Not read yet: Redis arrives with BullMQ in stage 5
REDIS_URL=redis://localhost:6379
