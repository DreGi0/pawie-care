# Copy to .env and adjust. Validated at startup by src/config/environment.ts.
# Values match docker-compose.yml at the repo root.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://pawie:pawie@localhost:5432/pawie
# Comma-separated browser origins allowed by CORS (the native app doesn't need any)
CORS_ORIGINS=
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Number of reverse proxies in front of the API (1 on Railway or Render)
TRUST_PROXY=0

# Signs the access tokens: at least 32 characters. Use a different one in each deployed
# environment: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=local-development-only-secret-change-me
# Access tokens last this many seconds; refresh tokens, this many days
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Password of the demo owner that pnpm db:seed creates (demo@example.com). Leave it empty
# to skip the owner, and use another one on the deployed demo, which is public
DEMO_OWNER_PASSWORD=pawie-demo-local

# S3-compatible file storage. Locally, the SeaweedFS of docker-compose.yml
S3_ENDPOINT=http://localhost:8333
# Host in the signed URLs the apps use. Empty means S3_ENDPOINT, which works on the iOS
# Simulator; the Android emulator reaches this computer at http://10.0.2.2:8333
S3_PUBLIC_ENDPOINT=
S3_REGION=auto
S3_BUCKET=pawie-files
S3_ACCESS_KEY_ID=pawie
S3_SECRET_ACCESS_KEY=pawie-local-secret

# Not read yet: Redis arrives with BullMQ in stage 5
REDIS_URL=redis://localhost:6379
